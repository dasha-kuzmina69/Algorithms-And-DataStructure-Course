# ============================================================================
# Makefile для лабораторной работы №25 и №26
# АТД: Линейный список (двунаправленный)
# Процедура №6: поиск и перемещение нарушающего порядка элемента
# Метод сортировки: вариант метода вставки
# ============================================================================

CC = gcc
LD = gcc
CCFLAGS = -g -Wall -pedantic -std=c99
LDFLAGS = 

TARGET = sort_program
SOURCES = sort.c
OBJECTS = sort.o

all: $(TARGET)

$(TARGET): $(OBJECTS)
	$(LD) $(LDFLAGS) -o $(TARGET) $(OBJECTS)
	@echo "=========================================="
	@echo "Сборка завершена! Исполняемый файл: $(TARGET)"
	@echo "=========================================="

sort.o: sort.c
	$(CC) $(CCFLAGS) -c sort.c -o sort.o

clean:
	rm -f $(OBJECTS) $(TARGET)
	@echo "Удалены объектные файлы и $(TARGET)"

run: $(TARGET)
	./$(TARGET)

debug: $(TARGET)
	gdb ./$(TARGET)

help:
	@echo "============================================================"
	@echo "Makefile для лабораторных работ №25 и №26"
	@echo "============================================================"
	@echo "Доступные цели:"
	@echo "  make          - собрать программу"
	@echo "  make clean    - удалить объектные файлы и исполняемый файл"
	@echo "  make run      - собрать и запустить программу"
	@echo "  make debug    - собрать и запустить отладчик gdb"
	@echo "  make help     - показать эту справку"
	@echo "============================================================"

.PHONY: all clean run debug help
